{
  "name": "receipts-express",
  "private": true,
  "version": "1.13.0",
  "description": "Scan receipts, organize expense reports, export polished PDFs.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare-assets": "node scripts/copy-tesseract-assets.mjs && node scripts/copy-pdfjs-assets.mjs && node scripts/copy-font-assets.mjs",
    "predev": "npm run prepare-assets",
    "prebuild": "npm run prepare-assets",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "dompurify": "^3.4.13",
    "fast-uri": "^3.1.5",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23"
  }
}
