{
  "name": "receipts-express",
  "private": true,
  "version": "1.17.0",
  "description": "Scan receipts, organize expense reports, export polished PDFs.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare-assets": "node scripts/copy-tesseract-assets.mjs && node scripts/copy-pdfjs-assets.mjs && node scripts/copy-font-assets.mjs",
    "predev": "npm run prepare-assets",
    "prebuild": "npm run prepare-assets",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "fast-uri": "^3.1.9",
    "filelist": {
      "brace-expansion": "^2.1.8"
    },
    "glob": "^14.0.2"
  }
}
